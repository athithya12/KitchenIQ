# ==========================================================
# KitchenIQ Backend Environment Variables
#
# INSTRUCTIONS:
# 1. Copy this file to .env.development 
# 2. Fill in the placeholder values below with actual secrets/URLs.
# 3. DO NOT COMMIT .env.dev to Git.
#
# Context: These variables are for the standard 'dev' environment
# running locally via runserver or targeting a cloud dev instance.
# ==========================================================

# ----------------------------------------------------------
# CORE DJANGO SETTINGS
# ----------------------------------------------------------
# CRITICAL: Django Secret Key. MUST be a long, randomly generated string.
SECRET_KEY="<GENERATE_A_LONG_AND_SECURE_SECRET_KEY>"
DEBUG="True"
ALLOWED_HOSTS="localhost,127.0.0.1,*"

# ----------------------------------------------------------
# 1. DATABASE (PostgreSQL) 
# ----------------------------------------------------------
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE_NAME
# This URL points to your external PostgreSQL service.
DATABASE_URL="postgres://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>"

# ----------------------------------------------------------
# 2. CACHE / MESSAGE QUEUE (Redis)
# ----------------------------------------------------------
# Format: redis://:PASSWORD@HOST:PORT/0
# This URL points to your external Redis service for Channels.
REDIS_URL="redis://:<REDIS_PASSWORD>@<REDIS_HOST>:<REDIS_PORT>/0"

# ----------------------------------------------------------
# 3. AUTHENTICATION (Supertokens)
# ----------------------------------------------------------
# The connection URI for the Supertokens Core service.
SUPERTK_HOST="<YOUR_SUPERTK_CORE_HOST_URL>" 

# Domain Definitions (For CORS and Supertokens config)
# Frontend URL
WEBSITE_DOMAIN="http://localhost:3000"
# Backend URL
API_DOMAIN="http://localhost:8000"


# ----------------------------------------------------------
# 4. FILE STORAGE (AWS S3)
# ----------------------------------------------------------
# AWS S3 Endpoint URL
AWS_S3_ENDPOINT_URL="<YOUR_AWS_S3_ENDPOINT_URL>"
# AWS S3 Access Key and Secret Key generated in the dashboard
AWS_S3_ACCESS_KEY_ID="<YOUR_AWS_S3_ACCESS_KEY_ID>"
AWS_S3_SECRET_ACCESS_KEY="<YOUR_AWS_S3_ECRET_ACCESS_KEY>"
# The bucket name
AWS_STORAGE_BUCKET_NAME="<YOUR_AWS_S3_BUCKET_NAME>"